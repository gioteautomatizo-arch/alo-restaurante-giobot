import assert from 'node:assert/strict';
import { readFileSync } from 'node:fs';
import type { BusinessCatalogItem } from '../src/lib/businessCatalogService.ts';
import { canSubmitBusinessPosOrder, isSimpleBusinessPosItem, outdatedBusinessPosCartIds } from '../src/lib/businessPosReadiness.ts';
const a: BusinessCatalogItem = { id: 'a-1', name: 'Café', description: '', price: 25, available: true, category: 'Bebidas', sortOrder: 1 };
const b: BusinessCatalogItem = { ...a, id: 'b-1', name: 'Café', price: 50 };
const cart = [{ item: a, quantity: 2 }];
assert.equal(isSimpleBusinessPosItem(a), true);
assert.equal(isSimpleBusinessPosItem({ ...a, price: 0 }), true);
for (const price of [null, -1, Infinity, Number.NaN]) assert.equal(isSimpleBusinessPosItem({ ...a, price }), false);
const required = { ...a, optionGroups: [{ id: 'size', name: 'Tamaño', required: true, multiple: false, choices: [{ name: 'Grande', price: 5 }] }] };
assert.equal(isSimpleBusinessPosItem(required), false);
assert.equal(isSimpleBusinessPosItem({ ...a, available: false }), false);
assert.deepEqual(outdatedBusinessPosCartIds(cart, [a]), []);
assert.deepEqual(outdatedBusinessPosCartIds(cart, [b]), ['a-1'], 'No usar productos de otro negocio con nombre similar');
assert.deepEqual(outdatedBusinessPosCartIds(cart, []), ['a-1']);
assert.deepEqual(outdatedBusinessPosCartIds(cart, [{ ...a, price: 30 }]), ['a-1']);
assert.deepEqual(outdatedBusinessPosCartIds(cart, [{ ...a, name: 'Café grande' }]), ['a-1']);
assert.deepEqual(outdatedBusinessPosCartIds(cart, [{ ...a, available: false }]), ['a-1']);
assert.deepEqual(outdatedBusinessPosCartIds(cart, [required]), ['a-1']);
assert.deepEqual(outdatedBusinessPosCartIds([{ ...cart[0], quantity: 0 }], [a]), ['a-1']);
assert.deepEqual(outdatedBusinessPosCartIds([{ ...cart[0], quantity: 1.5 }], [a]), ['a-1']);
assert.equal(canSubmitBusinessPosOrder('ready', cart, [a], false), true);
assert.equal(canSubmitBusinessPosOrder('loading', cart, [a], false), false);
assert.equal(canSubmitBusinessPosOrder('error', cart, [a], false), false);
assert.equal(canSubmitBusinessPosOrder('ready', cart, [a], true), false);
assert.equal(canSubmitBusinessPosOrder('ready', [], [a], false), false);
assert.equal(canSubmitBusinessPosOrder('ready', cart, [b], false), false);
const operations = readFileSync('src/components/platform/BusinessOperationsView.tsx', 'utf8');
assert.match(operations, /const catalogReady = isBusinessSummaryFeedReady\(businessId, catalogFeed\)/);
assert.match(operations, /const ordersReady = isBusinessSummaryFeedReady\(businessId, ordersFeed\)/);
assert.match(operations, /if \(active\) setCatalogFeed/);
assert.match(operations, /if \(active\) setOrdersFeed/);
assert.match(operations, /if \(!canSubmit\)/);
assert.match(operations, /disabled=\{!canSubmit\}/);
assert.match(operations, /submitInFlight\.current = true/);
assert.match(operations, /if \(!ordersReady \|\| !order.id\)/);
assert.match(operations, /!ordersReady \? \(/);
assert.match(operations, /catalogReady && availableCatalog\.length === 0/);
console.log('PASS: POS bloquea catálogo fallido, productos obsoletos y otro tenant; listas de pedidos no muestran falsos vacíos.');
