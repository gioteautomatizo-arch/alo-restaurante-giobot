rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{businessId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.restaurantId == businessId
        && !exists(/databases/$(database)/documents/businesses/$(businessId));

      allow update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/businessMemberships/$(businessId + '_' + request.auth.uid))
        && get(/databases/$(database)/documents/businessMemberships/$(businessId + '_' + request.auth.uid)).data.role == 'OWNER';
    }

    match /businessMemberships/{membershipId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'OWNER';

      allow update, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }

    
    function isValidRestaurant(data) {
      return data.restaurantId == 'alo-restaurante';
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Un tenant conocido puede operar con sus datos públicos (QR/cliente).
    // Calientito conserva su identificador histórico; los nuevos negocios
    // se validan contra el documento businesses/{restaurantId}.
    function isKnownRestaurant(data) {
      return data.restaurantId is string
        && (
          data.restaurantId == 'alo-restaurante'
          || exists(/databases/$(database)/documents/businesses/$(data.restaurantId))
        );
    }

    // Las operaciones administrativas requieren membresía activa.
    function isAuthorizedRestaurant(data) {
      return isSignedIn()
        && data.restaurantId is string
        && (
          data.restaurantId == 'alo-restaurante'
          || (
            exists(/databases/$(database)/documents/businessMemberships/$(data.restaurantId + '_' + request.auth.uid))
            && get(/databases/$(database)/documents/businessMemberships/$(data.restaurantId + '_' + request.auth.uid)).data.active == true
          )
        );
    }

    match /staff_users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isKnownRestaurant(request.resource.data) 
        && request.resource.data.name is string 
        && request.resource.data.role in ['DUEÑA', 'ADMINISTRADOR', 'ENCARGADO', 'CAJA', 'MESERO', 'COCINA', 'EMPLEADO'];
      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /shifts/{shiftId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.status in ['abierto', 'cerrado']
        && request.resource.data.initialCashFund is number;
      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.concept is string
        && request.resource.data.amount is number
        && request.resource.data.amount >= 0;
      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /cxc_records/{cxcId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.person is string
        && request.resource.data.amount is number
        && request.resource.data.status in ['Pendiente', 'Pagado', 'Anulado'];
      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /inventory_items/{itemId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.name is string;
      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /sobre_movements/{movementId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.amount is number;
      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /daily_menu/{menuDoc} {
      allow read: if true;
      allow create, update: if isAuthorizedRestaurant(request.resource.data);
      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /activity_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.action is string;
      allow update, delete: if false;
    }

    match /vip_profiles/{profileId} {
      allow get: if true;
      allow list: if isSignedIn();

      allow create: if (
        isAuthorizedRestaurant(request.resource.data)
      ) || (
        isKnownRestaurant(request.resource.data)
        && request.resource.data.phone is string
        && request.resource.data.phone.size() == 10
        && request.resource.data.customerName is string
        && request.resource.data.stamps == 0
        && request.resource.data.totalOrders == 0
        && request.resource.data.rewardAvailable == false
        && request.resource.data.pinHash is string
      );

      allow update: if (
        isAuthorizedRestaurant(request.resource.data)
      ) || (
        isKnownRestaurant(request.resource.data)
        && request.resource.data.stamps == resource.data.stamps
        && request.resource.data.totalOrders == resource.data.totalOrders
        && request.resource.data.rewardAvailable == resource.data.rewardAvailable
        && request.resource.data.memberId == resource.data.memberId
        && request.resource.data.restaurantId == resource.data.restaurantId
        && request.resource.data.phone == resource.data.phone
        && request.resource.data.pinHash == resource.data.pinHash
        && request.resource.data.customerName is string
      );

      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /tables/{tableId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.status in ['LIBRE', 'OCUPADA', 'CUENTA', 'LIMPIEZA'];
      allow update: if (
        request.auth == null
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.status == 'OCUPADA'
        && request.resource.data.tableNumber in [1, 2, 4, 5, 6, 7, 8, 9]
        && request.resource.data.tableId == resource.data.tableId
      ) || (
        isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.status in ['LIBRE', 'OCUPADA', 'CUENTA', 'LIMPIEZA']
      );
      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /table_service_requests/{requestId} {
      allow create: if (
        request.auth == null
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.status == 'PENDIENTE'
        && request.resource.data.tableNumber in [1, 2, 4, 5, 6, 7, 8, 9]
        && request.resource.data.requestType in ['LLAMAR_MESERO', 'TORTILLAS', 'BEBIDAS', 'SEGUNDO_TIEMPO', 'TERCER_TIEMPO', 'PEDIR_CUENTA']
        && request.resource.data.createdAt is string
        && request.resource.data.keys().hasOnly(['tableNumber', 'requestType', 'status', 'restaurantId', 'createdAt'])
      ) || (
        isSignedIn()
        && isKnownRestaurant(request.resource.data)
      );

      allow read: if true;
      allow update, delete: if isAuthorizedRestaurant(resource.data);
    }

    match /restaurant_orders/{orderId} {
      allow create: if (
        isKnownRestaurant(request.resource.data)
        && request.resource.data.status == 'NUEVO'
        && request.resource.data.orderType in ['dine_in', 'pickup', 'delivery']
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.code is string
        && request.resource.data.createdAt is string
      );

      allow read: if isSignedIn();

      allow update: if isAuthorizedRestaurant(resource.data)
        && isAuthorizedRestaurant(request.resource.data)
        && request.resource.data.status in ['NUEVO', 'PREPARANDO', 'LISTO', 'ENTREGADO', 'CANCELADO'];

      allow delete: if false;
    }

    match /public_table_orders/{orderId} {
      allow read: if true;

      allow create: if (
        isKnownRestaurant(request.resource.data)
        && request.resource.data.tableNumber in [1, 2, 4, 5, 6, 7, 8, 9]
        && request.resource.data.orderId == orderId
        && request.resource.data.code is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.status == 'NUEVO'
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string
      );

      allow update: if isAuthorizedRestaurant(resource.data)
        && isAuthorizedRestaurant(request.resource.data)
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.tableNumber == resource.data.tableNumber
        && request.resource.data.items == resource.data.items
        && request.resource.data.total == resource.data.total
        && request.resource.data.code == resource.data.code;

      allow delete: if false;
    }

    match /table_sessions/{sessionId} {
      allow get: if true;
      allow list: if isSignedIn();

      allow create: if (
        request.auth == null
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.tableNumber in [1, 2, 4, 5, 6, 7, 8, 9]
        && (request.resource.data.guestCount is int || request.resource.data.guestCount is number)
        && request.resource.data.guestCount >= 1
        && request.resource.data.guestCount <= 20
        && request.resource.data.accountMode == 'GENERAL'
        && request.resource.data.accounts is list
        && request.resource.data.accounts.size() == 1
        && request.resource.data.accounts[0].id == 'general'
        && request.resource.data.accounts[0].label is string
        && request.resource.data.status == 'ACTIVA'
        && request.resource.data.openedBy == 'QR'
        && request.resource.data.openedAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.keys().hasOnly([
          'restaurantId', 'tableNumber', 'guestCount', 'accountMode', 'accounts',
          'status', 'openedBy', 'openedAt', 'updatedAt'
        ])
      ) || (
        isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.tableNumber in [1, 2, 4, 5, 6, 7, 8, 9]
        && request.resource.data.status in ['ACTIVA', 'CUENTA', 'CERRADA']
        && request.resource.data.accountMode in ['GENERAL', 'SEPARADAS']
      );

      allow update: if (
        request.auth == null
        && resource.data.status == 'CERRADA'
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.tableNumber in [1, 2, 4, 5, 6, 7, 8, 9]
        && request.resource.data.tableNumber == resource.data.tableNumber
        && (request.resource.data.guestCount is int || request.resource.data.guestCount is number)
        && request.resource.data.guestCount >= 1
        && request.resource.data.guestCount <= 20
        && request.resource.data.accountMode == 'GENERAL'
        && request.resource.data.accounts is list
        && request.resource.data.accounts.size() == 1
        && request.resource.data.accounts[0].id == 'general'
        && request.resource.data.accounts[0].label is string
        && request.resource.data.status == 'ACTIVA'
        && request.resource.data.openedBy == 'QR'
        && request.resource.data.openedAt is string
        && request.resource.data.updatedAt is string
        && request.resource.data.keys().hasOnly([
          'restaurantId', 'tableNumber', 'guestCount', 'accountMode', 'accounts',
          'status', 'openedBy', 'openedAt', 'updatedAt'
        ])
      ) || (
        request.auth == null
        && resource.data.openedBy == 'MESERO'
        && resource.data.status == 'ACTIVA'
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.tableNumber in [1, 2, 4, 5, 6, 7, 8, 9]
        && request.resource.data.tableNumber == resource.data.tableNumber
        && (request.resource.data.guestCount is int || request.resource.data.guestCount is number)
        && request.resource.data.guestCount >= 1
        && request.resource.data.guestCount <= 20
        && request.resource.data.updatedAt is string
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'guestCount', 'updatedAt', 'updatedById', 'updatedByName'
        ])
      ) || (
        isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.tableNumber == resource.data.tableNumber
        && request.resource.data.status in ['ACTIVA', 'CUENTA', 'CERRADA']
        && request.resource.data.accountMode in ['GENERAL', 'SEPARADAS']
      );

      allow delete: if isAuthorizedRestaurant(resource.data);
    }

    match /table_payments/{paymentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.tableNumber in [1, 2, 4, 5, 6, 7, 8, 9]
        && request.resource.data.orderIds is list
        && request.resource.data.orderIds.size() > 0
        && request.resource.data.subtotal is number
        && request.resource.data.discountAmount is number
        && request.resource.data.tipAmount is number
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.paymentMethod in ['EFECTIVO', 'TARJETA', 'TRANSFERENCIA', 'MERCADO_PAGO', 'MIXTO']
        && request.resource.data.status == 'PAGADO'
        && request.resource.data.createdAt is string
        && request.resource.data.chargedById is string
        && request.resource.data.chargedByName is string;

      allow update, delete: if false;
    }

    match /sale_receipts/{receiptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && isKnownRestaurant(request.resource.data)
        && request.resource.data.tableNumber in [1, 2, 4, 5, 6, 7, 8, 9]
        && request.resource.data.tableSessionId is string
        && request.resource.data.orderIds is list
        && request.resource.data.paymentIds is list
        && request.resource.data.orders is list
        && request.resource.data.payments is list
        && request.resource.data.subtotal is number
        && request.resource.data.discountAmount is number
        && request.resource.data.tipAmount is number
        && request.resource.data.totalPaid is number
        && request.resource.data.status == 'PAGADO'
        && request.resource.data.openedAt is string
        && request.resource.data.closedAt is string
        && request.resource.data.closedById is string
        && request.resource.data.closedByName is string;

      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
