rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{restaurantId}/menu/{allPaths=**} {
      allow read: if true;

      allow create, update: if request.auth != null
        && (
          restaurantId == 'alo-restaurante'
          || (
            exists(/databases/(default)/documents/businessMemberships/$(restaurantId + '_' + request.auth.uid))
            && get(/databases/(default)/documents/businessMemberships/$(restaurantId + '_' + request.auth.uid)).data.active == true
          )
        )
        && request.resource != null
        && request.resource.size < 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');

      allow delete: if request.auth != null
        && (
          restaurantId == 'alo-restaurante'
          || (
            exists(/databases/(default)/documents/businessMemberships/$(restaurantId + '_' + request.auth.uid))
            && get(/databases/(default)/documents/businessMemberships/$(restaurantId + '_' + request.auth.uid)).data.active == true
          )
        );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
